# Editor settings. Line endings come from .gitattributes; file encodings (some .cs and .ps1 files carry a UTF-8 BOM)
# are left as they are.
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
